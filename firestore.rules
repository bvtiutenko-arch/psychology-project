rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read, create, and update their own user document. Delete is disallowed for safety.
    match /users/{userId} {
      allow read, create: if request.auth.uid == userId;
      // Allow update but prevent changing immutable fields like uid and createdAt
      allow update: if request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Users can read and write their own mood logs, ensuring they own the record
    match /mood_logs/{logId} {
      allow read, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
    }
    
    // Users can read and write their own SOS sessions, ensuring they own the record
    match /sos_sessions/{sessionId} {
      allow read, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
    }
    
    // Users can read and write their own causal matrices, ensuring they own the record
    match /causal_matrices/{matrixId} {
      allow read, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
    }

    // Users can read and write their own night mode entries, ensuring they own the record
    match /night_mode_entries/{entryId} {
      allow read, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
    }

    // Users can read and write their own tomorrow tasks, ensuring they own the record
    match /tomorrow_tasks/{taskId} {
      allow read, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
    }

    // Users can read and write their own test results, ensuring they own the record
    match /testResults/{resultId} {
      allow read, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
    }

    // Users can read and write their own session history, ensuring they own the record
    match /sessionHistory/{sessionId} {
      allow read, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
    }

    // Users can read and write their own experiments, ensuring they own the record
    match /experiments/{experimentId} {
      allow read, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
    }
  }
}
