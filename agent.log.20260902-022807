import { useState } from 'react';                                               
                                                                                
import { useAuth } from '../../hooks/useAuth';                                  
                                                                                
import { saveAppEvent } from '../../services/db';                               
                                                                                
import { AppEvent, EventType, Emotion, Behavior } from '../../types/causal';    
                                                                                
import { useNavigate } from 'react-router-dom';                                 
                                                                                
import toast from 'react-hot-toast';                                            
                                                                                
                                                                                
                                                                                
export default function EventCapture() {                                        
                                                                                
  const { user } = useAuth();                                                   
                                                                                
  const navigate = useNavigate();                                               
                                                                                
  const [step, setStep] = useState(1);                                          
                                                                                
  const [eventData, setEventData] = useState<Partial<AppEvent>>({               
                                                                                
    eventType: EventType.Personal,                                              
                                                                                
    emotion: Emotion.Anxiety,                                                   
                                                                                
    behavior: Behavior.Ruminating,                                              
                                                                                
    intensity: 5                                                                
                                                                                
  });                                                                           
                                                                                
                                                                                
                                                                                
  const handleNext = (data: Partial<AppEvent>) => {                             
                                                                                
    setEventData(prev => ({ ...prev, ...data }));                               
                                                                                
    setStep(prev => prev + 1);                                                  
                                                                                
  };                                                                            
                                                                                
                                                                                
                                                                                
  const handleSubmit = async () => {                                            
                                                                                
    if (!user) return;                                                          
                                                                                
    try {                                                                       
                                                                                
      await saveAppEvent({                                                      
                                                                                
        ...eventData as AppEvent,                                               
                                                                                
        userId: user.uid                                                        
                                                                                
      });                                                                       
                                                                                
      toast.success('Registro guardado.');                                      
                                                                                
      navigate('/dashboard');                                                   
                                                                                
    } catch (error) {                                                           
                                                                                
      console.error('Error saving event:', error);                              
                                                                                
      toast.error('Error al guardar.');                                         
                                                                                
    }                                                                           
                                                                                
  };                                                                            
                                                                                
                                                                                
                                                                                
  return (                                                                      
                                                                                
    <div className="p-4 max-w-md mx-auto">                                      
                                                                                
      <h1 className="text-xl font-bold text-gray-800 mt-4 mb-6">Nuevo           
Registro</h1>                                                                   
                                                                                
                                                                                
                                                                                
      {step === 1 && (                                                          
                                                                                
        <div className="space-y-4">                                             
                                                                                
          <h2 className="text-lg font-medium">¿Qué pasó?</h2>                   
                                                                                
          <input                                                                
                                                                                
            type="text"                                                         
                                                                                
            placeholder="Situación (ej: Mensaje sin respuesta)"                 
                                                                                
            className="w-full p-3 border rounded-lg"                            
                                                                                
            onChange={e => setEventData(prev => ({ ...prev, situation:          
e.target.value }))}                                                             
                                                                                
          />                                                                    
                                                                                
          <input                                                                
                                                                                
            type="text"                                                         
                                                                                
            placeholder="Contexto (ej: En la noche, solo)"                      
                                                                                
            className="w-full p-3 border rounded-lg"                            
                                                                                
            onChange={e => setEventData(prev => ({ ...prev, context:            
e.target.value }))}                                                             
                                                                                
          />                                                                    
                                                                                
          <button                                                               
                                                                                
            onClick={() => handleNext({})}                                      
                                                                                
            className="w-full bg-indigo-600 text-white p-3 rounded-lg           
font-medium"                                                                    
                                                                                
          >                                                                     
                                                                                
            Siguiente                                                           
                                                                                
          </button>                                                             
                                                                                
        </div>                                                                  
                                                                                
      )}                                                                        
                                                                                
                                                                                
                                                                                
      {step === 2 && (                                                          
                                                                                
        <div className="space-y-4">                                             
                                                                                
          <h2 className="text-lg font-medium">¿Qué pensaste y sentiste?</h2>    
                                                                                
          <input                                                                
                                                                                
            type="text"                                                         
                                                                                
            placeholder="Pensamiento (ej: Ya no le importo)"                    
                                                                                
            className="w-full p-3 border rounded-lg"                            
                                                                                
            onChange={e => setEventData(prev => ({ ...prev, thought:            
e.target.value }))}                                                             
                                                                                
          />                                                                    
                                                                                
          <select                                                               
                                                                                
            className="w-full p-3 border rounded-lg"                            
                                                                                
            onChange={e => setEventData(prev => ({ ...prev, emotion:            
e.target.value as Emotion }))}                                                  
                                                                                
            value={eventData.emotion}                                           
                                                                                
          >                                                                     
                                                                                
            {Object.values(Emotion).map(e => <option key={e}                    
value={e}>{e}</option>)}                                                        
                                                                                
          </select>                                                             
                                                                                
          <div>                                                                 
                                                                                
            <label className="block text-sm mb-1">Intensidad:                   
{eventData.intensity}</label>                                                   
                                                                                
            <input                                                              
                                                                                
              type="range" min="1" max="10"                                     
                                                                                
              className="w-full"                                                
                                                                                
              onChange={e => setEventData(prev => ({ ...prev, intensity:        
Number(e.target.value) }))}                                                     
                                                                                
              value={eventData.intensity}                                       
                                                                                
            />                                                                  
                                                                                
          </div>                                                                
                                                                                
          <button                                                               
                                                                                
            onClick={() => handleNext({})}                                      
                                                                                
            className="w-full bg-indigo-600 text-white p-3 rounded-lg           
font-medium"                                                                    
                                                                                
          >                                                                     
                                                                                
            Siguiente                                                           
                                                                                
          </button>                                                             
                                                                                
        </div>                                                                  
                                                                                
      )}                                                                        
                                                                                
                                                                                
                                                                                
      {step === 3 && (                                                          
                                                                                
        <div className="space-y-4">                                             
                                                                                
          <h2 className="text-lg font-medium">¿Qué hiciste?</h2>                
                                                                                
          <select                                                               
                                                                                
            className="w-full p-3 border rounded-lg"                            
                                                                                
            onChange={e => setEventData(prev => ({ ...prev, behavior:           
e.target.value as Behavior }))}                                                 
                                                                                
            value={eventData.behavior}                                          
                                                                                
          >                                                                     
                                                                                
            {Object.values(Behavior).map(b => <option key={b}                   
value={b}>{b}</option>)}                                                        
                                                                                
          </select>                                                             
                                                                                
          <input                                                                
                                                                                
            type="text"                                                         
                                                                                
            placeholder="Resultado inmediato (ej: Me sentí peor)"               
                                                                                
            className="w-full p-3 border rounded-lg"                            
                                                                                
            onChange={e => setEventData(prev => ({ ...prev, immediateOutcome:   
e.target.value }))}                                                             
                                                                                
          />                                                                    
                                                                                
          <button                                                               
                                                                                
            onClick={handleSubmit}                                              
                                                                                
            className="w-full bg-green-600 text-white p-3 rounded-lg            
font-medium"                                                                    
                                                                                
          >                                                                     
                                                                                
            Guardar Registro                                                    
                                                                                
          </button>                                                             
                                                                                
        </div>                                                                  
                                                                                
      )}                                                                        
                                                                                
    </div>                                                                      
                                                                                
  );                                                                            
                                                                                
}                                                                               
                                                                                

