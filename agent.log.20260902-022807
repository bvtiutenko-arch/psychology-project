import { useEffect, useState } from 'react';                                    
                                                                                
import { useAuth } from '../../hooks/useAuth';                                  
                                                                                
import { getAppEvents } from '../../services/db';                               
                                                                                
import { analyzePatterns, getPatternSummary } from                              
'../../services/patternEngine';                                                 
                                                                                
import { AppEvent, PatternMap } from '../../types/causal';                      
                                                                                
import { useNavigate } from 'react-router-dom';                                 
                                                                                
import { ArrowLeft } from 'lucide-react';                                       
                                                                                
                                                                                
                                                                                
export default function ConnectionMap() {                                       
                                                                                
  const { user } = useAuth();                                                   
                                                                                
  const navigate = useNavigate();                                               
                                                                                
  const [events, setEvents] = useState<AppEvent[]>([]);                         
                                                                                
  const [patternMap, setPatternMap] = useState<PatternMap | null>(null);        
                                                                                
  const [loading, setLoading] = useState(true);                                 
                                                                                
                                                                                
                                                                                
  useEffect(() => {                                                             
                                                                                
    if (!user) return;                                                          
                                                                                
    const fetchEvents = async () => {                                           
                                                                                
      try {                                                                     
                                                                                
        const userEvents = await getAppEvents(user.uid, 100);                   
                                                                                
        setEvents(userEvents);                                                  
                                                                                
        const map = analyzePatterns(userEvents);                                
                                                                                
        setPatternMap(map);                                                     
                                                                                
      } catch (error) {                                                         
                                                                                
        console.error('Error fetching events for map:', error);                 
                                                                                
      } finally {                                                               
                                                                                
        setLoading(false);                                                      
                                                                                
      }                                                                         
                                                                                
    };                                                                          
                                                                                
    fetchEvents();                                                              
                                                                                
  }, [user]);                                                                   
                                                                                
                                                                                
                                                                                
  return (                                                                      
                                                                                
    <div className="p-4 max-w-md mx-auto">                                      
                                                                                
      <button onClick={() => navigate('/dashboard')} className="p-2 -ml-2       
rounded-full hover:bg-gray-100 mb-4">                                           
                                                                                
        <ArrowLeft className="w-6 h-6" />                                       
                                                                                
      </button>                                                                 
                                                                                
                                                                                
                                                                                
      <h1 className="text-xl font-bold text-gray-800 mb-4">Mapa de              
Conexiones</h1>                                                                 
                                                                                
                                                                                
                                                                                
      {loading ? (                                                              
                                                                                
        <p className="text-gray-500">Analizando tus patrones...</p>             
                                                                                
      ) : events.length < 3 ? (                                                 
                                                                                
        <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-100
text-center">                                                                   
                                                                                
          <p className="text-gray-500">Necesitas al menos 3 registros para      
empezar a ver conexiones.</p>                                                   
                                                                                
          <p className="text-sm text-gray-400 mt-2">Actualmente tienes          
{events.length} registro(s).</p>                                                
                                                                                
        </div>                                                                  
                                                                                
      ) : (                                                                     
                                                                                
        <div className="space-y-4">                                             
                                                                                
          <div className="bg-white p-4 rounded-xl shadow-sm border              
border-gray-100">                                                               
                                                                                
            <h2 className="font-semibold text-gray-700 mb-2">Resumen</h2>       
                                                                                
            <p className="text-gray-600">{getPatternSummary(patternMap!)}</p>   
                                                                                
            <p className="text-xs text-gray-400 mt-2">Confianza del patrón:     
{patternMap!.confidence}%</p>                                                   
                                                                                
          </div>                                                                
                                                                                
                                                                                
                                                                                
          <div className="bg-white p-4 rounded-xl shadow-sm border              
border-gray-100">                                                               
                                                                                
            <h2 className="font-semibold text-gray-700 mb-4">Tus Nodos</h2>     
                                                                                
            <div className="flex flex-wrap gap-2">                              
                                                                                
              {patternMap!.nodes.map(node => (                                  
                                                                                
                <span                                                           
                                                                                
                  key={node.id}                                                 
                                                                                
                  className={`px-3 py-1 rounded-full text-xs font-medium ${     
                                                                                
                    node.type === 'trigger' ? 'bg-yellow-100 text-yellow-800' : 
                                                                                
                    node.type === 'thought' ? 'bg-blue-100 text-blue-800' :     
                                                                                
                    node.type === 'emotion' ? 'bg-red-100 text-red-800' :       
                                                                                
                    'bg-purple-100 text-purple-800'                             
                                                                                
                  }`}                                                           
                                                                                
                >                                                               
                                                                                
                  {node.label}                                                  
                                                                                
                </span>                                                         
                                                                                
              ))}                                                               
                                                                                
            </div>                                                              
                                                                                
          </div>                                                                
                                                                                
                                                                                
                                                                                
          <div className="bg-white p-4 rounded-xl shadow-sm border              
border-gray-100">                                                               
                                                                                
            <h2 className="font-semibold text-gray-700 mb-4">Conexiones         
Detectadas</h2>                                                                 
                                                                                
            <ul className="space-y-2">                                          
                                                                                
              {patternMap!.edges.map((edge, i) => {                             
                                                                                
                const source = patternMap!.nodes.find(n => n.id ===             
edge.source);                                                                   
                                                                                
                const target = patternMap!.nodes.find(n => n.id ===             
edge.target);                                                                   
                                                                                
                return (                                                        
                                                                                
                  <li key={i} className="text-sm text-gray-600 flex items-center
gap-2">                                                                         
                                                                                
                    <span className="font-medium">{source?.label}</span>        
                                                                                
                    <span className="text-gray-400">→</span>                    
                                                                                
                    <span className="font-medium">{target?.label}</span>        
                                                                                
                    <span className="text-xs text-gray-400                      
ml-auto">({edge.frequency}x)</span>                                             
                                                                                
                  </li>                                                         
                                                                                
                );                                                              
                                                                                
              })}                                                               
                                                                                
            </ul>                                                               
                                                                                
          </div>                                                                
                                                                                
        </div>                                                                  
                                                                                
      )}                                                                        
                                                                                
    </div>                                                                      
                                                                                
  );                                                                            
                                                                                
}                                                                               
                                                                                

