export async function getNightModeEntries(userId: string):                      
Promise<NightModeEntry[]> {                                                     
  const q = query(collection(db, 'night_mode_entries'), where('userId', '==',   
userId), orderBy('timestamp', 'desc'));                                         
  const querySnapshot = await getDocs(q);                                       
  return querySnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() } as        
NightModeEntry));                                                               
}                                                                               
                                                                                
export async function exportUserData(userId: string): Promise<Record<string,    
any>> {                                                                         
  const [testResults, sessionHistory, causalMatrices, nightModeEntries] = await 
Promise.all([                                                                   
    getTestResults(userId),                                                     
    getSessionHistory(userId),                                                  
    getCausalMatrices(userId),                                                  
    getNightModeEntries(userId)                                                 
  ]);                                                                           
                                                                                
  return {                                                                      
    testResults,                                                                
    sessionHistory,                                                             
    causalMatrices,                                                             
    nightModeEntries,                                                           
    exportedAt: new Date().toISOString()                                        
  };                                                                            
}                                                                               
                                                                                
export async function deleteAllUserData(userId: string): Promise<void> {        
  const collectionsToDelete = ['testResults', 'sessionHistory',                 
'causal_matrices', 'night_mode_entries'];                                       
                                                                                
  for (const colName of collectionsToDelete) {                                  
    const q = query(collection(db, colName), where('userId', '==', userId));    
    const snapshot = await getDocs(q);                                          
                                                                                
    let batch = writeBatch(db);                                                 
    let count = 0;                                                              
                                                                                
    for (const doc of snapshot.docs) {                                          
      batch.delete(doc.ref);                                                    
      count++;                                                                  
      if (count === 400) { // Batch limit is 500, using 400 for safety          
        await batch.commit();                                                   
        batch = writeBatch(db);                                                 
        count = 0;                                                              
      }                                                                         
    }                                                                           
    if (count > 0) {                                                            
      await batch.commit();                                                     
    }                                                                           
  }                                                                             
}                                                                               
                                                                                

