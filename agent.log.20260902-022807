import { CausalInputs, TriggerEvent, CognitiveBias, SomaticCompulsion,          
FeedbackLoop } from '../types/causal';                                          
                                                                                
                                                                                
                                                                                
export interface AnalyzedEvent extends CausalInputs {                           
                                                                                
  id: string;                                                                   
                                                                                
  timestamp: number;                                                            
                                                                                
  anxietyLevel?: number;                                                        
                                                                                
  sleepQuality?: number;                                                        
                                                                                
}                                                                               
                                                                                
                                                                                
                                                                                
export interface Pattern {                                                      
                                                                                
  id: string;                                                                   
                                                                                
  type: 'connection' | 'repeated' | 'helpful';                                  
                                                                                
  title: string;                                                                
                                                                                
  description: string;                                                          
                                                                                
  confidence: number;                                                           
                                                                                
  frequency: number;                                                            
                                                                                
  evidence: AnalyzedEvent[];                                                    
                                                                                
}                                                                               
                                                                                
                                                                                
                                                                                
export function analyzePatterns(events: AnalyzedEvent[]): Pattern[] {           
                                                                                
  if (events.length < 3) return []; // Need sufficient data                     
                                                                                
                                                                                
                                                                                
  const patterns: Pattern[] = [];                                               
                                                                                
                                                                                
                                                                                
  // 1. Find repeated triggers                                                  
                                                                                
  const triggerCounts: Record<string, number> = {};                             
                                                                                
  events.forEach(e => {                                                         
                                                                                
    if (e.triggerEvent) {                                                       
                                                                                
      triggerCounts[e.triggerEvent] = (triggerCounts[e.triggerEvent] || 0) + 1; 
                                                                                
    }                                                                           
                                                                                
  });                                                                           
                                                                                
                                                                                
                                                                                
  Object.entries(triggerCounts).forEach(([trigger, count]) => {                 
                                                                                
    if (count >= 2) {                                                           
                                                                                
      patterns.push({                                                           
                                                                                
        id: `trigger-${trigger}`,                                               
                                                                                
        type: 'repeated',                                                       
                                                                                
        title: `Patrón repetido: ${trigger}`,                                   
                                                                                
        description: `El desencadenante "${trigger}" aparece ${count} veces en  
tus registros.`,                                                                
                                                                                
        confidence: Math.min(count / 5, 1), // Simple confidence metric         
                                                                                
        frequency: count,                                                       
                                                                                
        evidence: events.filter(e => e.triggerEvent === trigger),               
                                                                                
      });                                                                       
                                                                                
    }                                                                           
                                                                                
  });                                                                           
                                                                                
                                                                                
                                                                                
  // 2. Find connections (Trigger -> Bias)                                      
                                                                                
  const connectionCounts: Record<string, number> = {};                          
                                                                                
  events.forEach(e => {                                                         
                                                                                
    if (e.triggerEvent && e.cognitiveBias) {                                    
                                                                                
      const key = `${e.triggerEvent} -> ${e.cognitiveBias}`;                    
                                                                                
      connectionCounts[key] = (connectionCounts[key] || 0) + 1;                 
                                                                                
    }                                                                           
                                                                                
  });                                                                           
                                                                                
                                                                                
                                                                                
  Object.entries(connectionCounts).forEach(([key, count]) => {                  
                                                                                
    if (count >= 2) {                                                           
                                                                                
      const [trigger, bias] = key.split(' -> ');                                
                                                                                
      patterns.push({                                                           
                                                                                
        id: `conn-${key}`,                                                      
                                                                                
        type: 'connection',                                                     
                                                                                
        title: `Posible conexión: ${trigger} y ${bias}`,                        
                                                                                
        description: `Cuando ocurre "${trigger}", frecuentemente aparece el     
sesgo "${bias}".`,                                                              
                                                                                
        confidence: Math.min(count / 5, 1),                                     
                                                                                
        frequency: count,                                                       
                                                                                
        evidence: events.filter(e => e.triggerEvent === trigger &&              
e.cognitiveBias === bias),                                                      
                                                                                
      });                                                                       
                                                                                
    }                                                                           
                                                                                
  });                                                                           
                                                                                
                                                                                
                                                                                
  // 3. Find helpful patterns (Behaviors associated with lower anxiety)         
                                                                                
  // This requires anxietyLevel data. Assuming it exists.                       
                                                                                
  const compulsionAnxiety: Record<string, number[]> = {};                       
                                                                                
  events.forEach(e => {                                                         
                                                                                
    if (e.somaticCompulsion && e.anxietyLevel !== undefined) {                  
                                                                                
      if (!compulsionAnxiety[e.somaticCompulsion])                              
compulsionAnxiety[e.somaticCompulsion] = [];                                    
                                                                                
      compulsionAnxiety[e.somaticCompulsion].push(e.anxietyLevel);              
                                                                                
    }                                                                           
                                                                                
  });                                                                           
                                                                                
                                                                                
                                                                                
  Object.entries(compulsionAnxiety).forEach(([compulsion, levels]) => {         
                                                                                
    if (levels.length >= 2) {                                                   
                                                                                
      const avgAnxiety = levels.reduce((a, b) => a + b, 0) / levels.length;     
                                                                                
      if (avgAnxiety < 5) { // Assuming 1-10 scale, <5 is lower                 
                                                                                
        patterns.push({                                                         
                                                                                
          id: `helpful-${compulsion}`,                                          
                                                                                
          type: 'helpful',                                                      
                                                                                
          title: `Lo que te ayuda: ${compulsion}`,                              
                                                                                
          description: `Cuando haces "${compulsion}", tu ansiedad tiende a ser  
menor (promedio ${avgAnxiety.toFixed(1)}).`,                                    
                                                                                
          confidence: Math.min(levels.length / 5, 1),                           
                                                                                
          frequency: levels.length,                                             
                                                                                
          evidence: events.filter(e => e.somaticCompulsion === compulsion),     
                                                                                
        });                                                                     
                                                                                
      }                                                                         
                                                                                
    }                                                                           
                                                                                
  });                                                                           
                                                                                
                                                                                
                                                                                
  return patterns.sort((a, b) => b.confidence - a.confidence);                  
                                                                                
}                                                                               
                                                                                

